<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reconnaissance Assessment Report - {{ target }}</title>
    <style>
        /* Base Print Settings */
        @page {
            size: A4 portrait;
            margin: 2cm;
        }
        @page :first {
            margin: 0;
        }
        
        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            background-color: #fff;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        /* --- COVER PAGE --- */
        .cover-page {
            width: 100%;
            height: 297mm; /* A4 exact height */
            position: relative;
            page-break-after: always;
            overflow: hidden;
            background-color: #fff;
        }

        /* Left Blue Sidebar */
        .cover-sidebar {
            position: absolute;
            top: 0;
            left: 0;
            width: 25%;
            height: 100%;
            background-color: #315e96; /* Professional blue */
            z-index: 1;
        }

        /* Thin line inside sidebar */
        .cover-sidebar::after {
            content: '';
            position: absolute;
            top: 0;
            right: 20px;
            width: 1px;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.2);
        }

        /* Right Content Area */
        .cover-content {
            position: absolute;
            top: 0;
            left: 25%;
            width: 75%;
            height: 100%;
            padding: 80px 60px;
            z-index: 2;
        }

        /* Logo Area */
        .cover-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 60px;
        }
        .cover-logo-icon {
            width: 40px;
            height: 40px;
            background-color: #333;
            border-radius: 8px;
            display: inline-block;
        }
        .cover-logo-text {
            font-size: 16pt;
            font-weight: 700;
            color: #333;
            letter-spacing: 1px;
        }

        /* Titles */
        .cover-title-group {
            margin-top: 120px;
            max-width: 80%;
        }
        .cover-title {
            font-size: 32pt;
            font-weight: 800;
            color: #333;
            line-height: 1.1;
            margin-bottom: 20px;
            font-family: 'Times New Roman', Times, serif;
            text-transform: uppercase;
        }
        .cover-subtitle {
            font-size: 18pt;
            color: #555;
            line-height: 1.3;
            margin-bottom: 40px;
        }
        .cover-description {
            font-size: 11pt;
            color: #666;
            text-align: justify;
            max-width: 85%;
        }

        /* Footer Grey Area */
        .cover-footer {
            position: absolute;
            bottom: 0;
            left: 25%;
            width: 75%;
            height: 25%;
            background-color: #f2f2f2;
            padding: 40px 60px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
            text-align: right;
            z-index: 2;
        }
        .cover-footer-label {
            font-size: 16pt;
            font-weight: 700;
            color: #333;
            margin-bottom: 5px;
            font-family: 'Times New Roman', Times, serif;
        }
        .cover-footer-value {
            font-size: 11pt;
            color: #555;
            margin-bottom: 30px;
        }
        .cover-footer-value:last-child {
            margin-bottom: 0;
        }


        /* --- INNER PAGES --- */
        h2 { 
            font-family: 'Times New Roman', Times, serif;
            font-size: 20pt; 
            color: #315e96; 
            border-bottom: 2px solid #ebebeb; 
            padding-bottom: 10px; 
            margin-top: 0;
            page-break-before: always;
        }
        h3 { 
            font-size: 14pt; 
            color: #333; 
            margin-top: 30px; 
            margin-bottom: 15px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
            font-size: 10.5pt;
        }
        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 12px 15px;
            text-align: left;
        }
        th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #315e96;
            width: 30%;
        }
        
        ul { margin: 0; padding-left: 20px; }
        li { margin-bottom: 5px; font-size: 10.5pt; }
        
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 9pt;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-pass { background-color: #e6f4ea; color: #1e8e3e; }
        .status-fail { background-color: #fce8e6; color: #d93025; }
        .status-warn { background-color: #fef7e0; color: #f29900; }

    </style>
</head>
<body>

    <!-- Professional Cover Page -->
    <div class="cover-page">
        <div class="cover-sidebar"></div>
        
        <div class="cover-content">
            <!-- Logo -->
            <div class="cover-logo">
                <div class="cover-logo-icon">
                    <svg viewBox="0 0 24 24" width="40" height="40" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin: 8px;">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div class="cover-logo-text">ReconScope Framework</div>
            </div>

            <!-- Title Section -->
            <div class="cover-title-group">
                <div class="cover-title">WEB RECONNAISSANCE<br>ASSESSMENT REPORT</div>
                <div class="cover-subtitle">Target Profile, Digital Footprint,<br>and Security Posture Evaluation</div>
                
                <div class="cover-description">
                    This report presents the findings of an automated security reconnaissance assessment conducted against <strong>{{ target }}</strong>. 
                    It assesses the target's digital footprint, including network infrastructure, DNS configurations, TLS certificates, 
                    and HTTP security headers. The findings and observations documented herein aim to evaluate external exposure, 
                    strengthen security posture, and mitigate potential risks.
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="cover-footer">
            <div class="cover-footer-label">Prepared For</div>
            <div class="cover-footer-value" style="font-family: monospace;">{{ target }}</div>
            
            <div class="cover-footer-label">Scan ID</div>
            <div class="cover-footer-value" style="font-family: monospace;">{{ scan_id }}</div>

            <div class="cover-footer-label">Date</div>
            <div class="cover-footer-value">{{ generated_at }}</div>
        </div>
    </div>


    <!-- Executive Summary -->
    <h2>1. Executive Summary</h2>
    <p style="font-size: 11pt; text-align: justify; margin-bottom: 30px;">
        An automated web reconnaissance assessment was conducted against <strong>{{ target }}</strong>. 
        The purpose of this assessment was to identify the digital footprint, network infrastructure, and web application security 
        configurations associated with the target domain. This report provides a structured analysis of the findings discovered during the scan.
        The scan completed with a status of <strong>{{ status }}</strong> in {{ duration_seconds }} seconds.
    </p>

    <table style="margin-bottom: 40px;">
        <tr><th>Target Domain</th><td style="font-family: monospace; font-weight: bold;">{{ target }}</td></tr>
        <tr><th>Scan Duration</th><td>{{ duration_seconds }} seconds</td></tr>
        <tr><th>Primary IP Address</th><td>{{ ip.ipv4 if ip else 'N/A' }}</td></tr>
        <tr><th>HTTP Status</th><td>{{ http.status_code if http else 'N/A' }}</td></tr>
        <tr><th>TLS Status</th><td>
            {% if ssl and ssl.status == 'VALID' %}
                <span class="status-badge status-pass">VALID</span>
            {% elif ssl and ssl.status == 'EXPIRED' %}
                <span class="status-badge status-fail">EXPIRED</span>
            {% else %}
                <span class="status-badge status-warn">{{ ssl.status if ssl else 'N/A' }}</span>
            {% endif %}
        </td></tr>
    </table>


    <!-- Target Infrastructure -->
    <h2>2. Target Infrastructure</h2>
    
    <h3>2.1 IP & Geolocation Data</h3>
    {% if ip %}
    <table>
        <tr><th>IPv4 Address</th><td>{{ ip.ipv4 or 'N/A' }}</td></tr>
        <tr><th>IPv6 Address</th><td>{{ ip.ipv6 or 'N/A' }}</td></tr>
        <tr><th>ASN</th><td>{{ ip.asn or 'N/A' }} ({{ ip.asn_description or 'N/A' }})</td></tr>
        <tr><th>Organization / ISP</th><td>{{ ip.org or 'N/A' }} / {{ ip.isp or 'N/A' }}</td></tr>
        <tr><th>Geolocation</th><td>{{ ip.city or 'N/A' }}, {{ ip.region or 'N/A' }}, {{ ip.country or 'N/A' }}</td></tr>
    </table>
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">No IP information could be retrieved for the target.</p>
    {% endif %}

    <h3>2.2 WHOIS Registration Data</h3>
    {% if whois and whois.available %}
    <table>
        <tr><th>Registrar</th><td>{{ whois.registrar or 'N/A' }}</td></tr>
        <tr><th>Creation Date</th><td>{{ whois.creation_date or 'N/A' }}</td></tr>
        <tr><th>Updated Date</th><td>{{ whois.updated_date or 'N/A' }}</td></tr>
        <tr><th>Expiration Date</th><td>{{ whois.expiration_date or 'N/A' }}</td></tr>
        <tr><th>Name Servers</th><td>{{ whois.name_servers | join(', ') if whois.name_servers else 'N/A' }}</td></tr>
    </table>
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">WHOIS information is unavailable or privacy-protected.</p>
    {% endif %}


    <!-- Technical Analysis -->
    <h2>3. Technical Analysis</h2>
    
    <h3>3.1 DNS Enumeration</h3>
    {% if dns and dns.total_records > 0 %}
    <p style="font-size: 11pt; margin-bottom: 15px;">A total of <strong>{{ dns.total_records }}</strong> DNS records were discovered.</p>
    <table>
        <tr><th style="width: 20%;">Record Type</th><th>Discovered Records</th></tr>
        {% if dns.A %}<tr><td>A (IPv4)</td><td style="font-family: monospace;">{{ dns.A | join(', ') }}</td></tr>{% endif %}
        {% if dns.AAAA %}<tr><td>AAAA (IPv6)</td><td style="font-family: monospace;">{{ dns.AAAA | join(', ') }}</td></tr>{% endif %}
        {% if dns.MX %}<tr><td>MX (Mail)</td><td style="font-family: monospace;">{{ dns.MX | join(', ') }}</td></tr>{% endif %}
        {% if dns.NS %}<tr><td>NS (Nameservers)</td><td style="font-family: monospace;">{{ dns.NS | join(', ') }}</td></tr>{% endif %}
        {% if dns.TXT %}<tr><td>TXT (Text)</td><td style="font-family: monospace;">{{ dns.TXT | join('<br>') }}</td></tr>{% endif %}
        {% if dns.CNAME %}<tr><td>CNAME (Canonical)</td><td style="font-family: monospace;">{{ dns.CNAME | join(', ') }}</td></tr>{% endif %}
    </table>
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">No DNS records were enumerated.</p>
    {% endif %}

    <h3>3.2 HTTP Response</h3>
    {% if http %}
    <table>
        <tr><th>Final URL</th><td style="color: #315e96; text-decoration: underline;">{{ http.final_url }}</td></tr>
        <tr><th>Status Code</th><td><strong>{{ http.status_code }} {{ http.status_text }}</strong></td></tr>
        <tr><th>Server Software</th><td>{{ http.server or 'Hidden / Not Disclosed' }}</td></tr>
        <tr><th>Response Time</th><td>{{ http.response_time_ms }} ms</td></tr>
    </table>
    {% if http.redirect_chain %}
    <div style="background: #f8f9fa; padding: 15px; border-left: 4px solid #315e96; margin-top: 15px;">
        <strong>Redirect Chain Detected:</strong>
        <ul style="margin-top: 10px;">
            {% for hop in http.redirect_chain %}
            <li><span class="status-badge status-warn" style="margin-right: 10px;">{{ hop.status_code }}</span> {{ hop.url }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">No HTTP response was recorded.</p>
    {% endif %}

    <h3>3.3 TLS/SSL Certificate</h3>
    {% if ssl and ssl.status != 'UNAVAILABLE' %}
    <table>
        <tr><th>Certificate Status</th><td><strong>{{ ssl.status }}</strong></td></tr>
        <tr><th>Common Name (CN)</th><td>{{ ssl.common_name }}</td></tr>
        <tr><th>Issuer</th><td>{{ ssl.issuer_cn }}</td></tr>
        <tr><th>Valid From</th><td>{{ ssl.not_before }}</td></tr>
        <tr><th>Valid Until</th><td>{{ ssl.not_after }} ({{ ssl.days_remaining }} days remaining)</td></tr>
        <tr><th>TLS Protocol Version</th><td>{{ ssl.tls_version }}</td></tr>
    </table>
    {% if ssl.san %}
    <div style="background: #f8f9fa; padding: 15px; border-left: 4px solid #315e96; margin-top: 15px; page-break-inside: avoid;">
        <strong>Subject Alternative Names (SAN)</strong>
        <p style="font-family: monospace; font-size: 9.5pt; word-wrap: break-word; margin-top: 10px;">{{ ssl.san | join(', ') }}</p>
    </div>
    {% endif %}
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">TLS certificate information is unavailable or the target does not support HTTPS.</p>
    {% endif %}


    <!-- Security Observations -->
    <h2>4. Security Observations</h2>
    
    <h3>4.1 HTTP Security Headers</h3>
    {% if security and security.headers %}
    <div style="display: flex; gap: 20px; margin-bottom: 20px; page-break-inside: avoid;">
        <div style="flex: 1; background: #f8f9fa; padding: 20px; text-align: center; border-radius: 8px; border: 1px solid #ddd;">
            <div style="font-size: 24pt; font-weight: bold; color: #315e96;">{{ security.coverage_percent }}%</div>
            <div style="font-size: 10pt; text-transform: uppercase; color: #666;">Coverage Score</div>
        </div>
        <div style="flex: 2; display: flex; align-items: center; justify-content: space-around; background: #fff; border: 1px solid #ddd; border-radius: 8px;">
            <div style="text-align: center;"><div style="font-size: 18pt; font-weight: bold; color: #1e8e3e;">{{ security.present_count }}</div><div style="font-size: 9pt; color: #666;">PRESENT</div></div>
            <div style="text-align: center;"><div style="font-size: 18pt; font-weight: bold; color: #d93025;">{{ security.missing_count }}</div><div style="font-size: 9pt; color: #666;">MISSING</div></div>
            <div style="text-align: center;"><div style="font-size: 18pt; font-weight: bold; color: #f29900;">{{ security.informational_count }}</div><div style="font-size: 9pt; color: #666;">INFO</div></div>
        </div>
    </div>
    
    <table>
        <tr>
            <th style="width: 20%;">Security Header</th>
            <th style="width: 15%;">Status</th>
            <th>Analysis & Recommendation</th>
        </tr>
        {% for h in security.headers %}
        <tr>
            <td style="font-family: monospace; font-size: 9.5pt; font-weight: bold;">{{ h.name }}</td>
            <td>
                {% if h.status == 'PRESENT' %}<span class="status-badge status-pass">PRESENT</span>
                {% elif h.status == 'MISSING' %}<span class="status-badge status-fail">MISSING</span>
                {% else %}<span class="status-badge status-warn">INFO</span>{% endif %}
            </td>
            <td style="font-size: 9.5pt;">
                {% if h.value %}<div style="margin-bottom: 8px;"><strong style="color:#555;">Value:</strong> <span style="font-family: monospace;">{{ h.value[:100] }}{% if h.value|length > 100 %}...{% endif %}</span></div>{% endif %}
                {% if h.observation %}<div style="margin-bottom: 8px;">{{ h.observation }}</div>{% endif %}
                {% if h.impact %}<div style="color: #856404; background-color: #fff3cd; padding: 6px; border-radius: 4px; margin-bottom: 6px;"><strong>Impact:</strong> {{ h.impact }}</div>{% endif %}
                {% if h.recommendation %}<div style="color: #004085; background-color: #cce5ff; padding: 6px; border-radius: 4px;"><strong>Rec:</strong> {{ h.recommendation }}</div>{% endif %}
            </td>
        </tr>
        {% endfor %}
    </table>
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">No security header observations could be performed.</p>
    {% endif %}

    <h3>4.2 Web Files & Crawling</h3>
    {% if web_files %}
    <table style="margin-bottom: 20px;">
        <tr><th>robots.txt Status</th><td>{% if web_files.robots_txt_available %}<span class="status-badge status-pass">Found</span> (HTTP {{ web_files.robots_txt_status }}){% else %}<span class="status-badge status-fail">Not Found</span>{% endif %}</td></tr>
        <tr><th>sitemap.xml Status</th><td>{% if web_files.sitemap_xml_available %}<span class="status-badge status-pass">Found</span> (HTTP {{ web_files.sitemap_xml_status }}){% else %}<span class="status-badge status-fail">Not Found</span>{% endif %}</td></tr>
    </table>

    {% if web_files.sitemap_urls %}
    <div style="background: #f8f9fa; padding: 15px; border-left: 4px solid #315e96; margin-top: 15px; page-break-inside: avoid;">
        <strong>Discovered Sitemap URLs (limit 10)</strong>
        <ul style="margin-top: 10px;">
            {% for url in web_files.sitemap_urls[:10] %}
            <li style="font-size: 9.5pt; font-family: monospace; color: #444;">{{ url }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    {% else %}
    <p style="font-size: 11pt; color: #666; font-style: italic;">No web files were enumerated.</p>
    {% endif %}

</body>
</html>
