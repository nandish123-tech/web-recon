<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ReconScope Report — {{ target }}</title>
<style>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --surface2: #21262d;
    --border: #30363d;
    --text: #c9d1d9;
    --text-muted: #8b949e;
    --cyan: #58a6ff;
    --green: #3fb950;
    --amber: #d29922;
    --red: #f85149;
    --purple: #a371f7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; font-size: 14px; line-height: 1.6; }
  .page { max-width: 1100px; margin: 0 auto; padding: 40px 24px; }

  /* Cover */
  .cover { text-align: center; padding: 60px 0 40px; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
  .cover .logo { font-size: 13px; letter-spacing: 4px; color: var(--cyan); text-transform: uppercase; margin-bottom: 16px; }
  .cover h1 { font-size: 32px; font-weight: 700; margin-bottom: 8px; }
  .cover .target-display { font-size: 20px; color: var(--cyan); font-family: monospace; margin-bottom: 20px; }
  .cover .meta { color: var(--text-muted); font-size: 13px; }
  .cover .meta span { margin: 0 12px; }

  /* Status badge */
  .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  .badge-green { background: rgba(63,185,80,0.15); color: var(--green); border: 1px solid rgba(63,185,80,0.3); }
  .badge-amber { background: rgba(210,153,34,0.15); color: var(--amber); border: 1px solid rgba(210,153,34,0.3); }
  .badge-red { background: rgba(248,81,73,0.15); color: var(--red); border: 1px solid rgba(248,81,73,0.3); }
  .badge-blue { background: rgba(88,166,255,0.15); color: var(--cyan); border: 1px solid rgba(88,166,255,0.3); }
  .badge-gray { background: rgba(139,148,158,0.15); color: var(--text-muted); border: 1px solid rgba(139,148,158,0.3); }

  /* Summary cards */
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 40px; }
  .summary-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px 16px; }
  .summary-card .label { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; }
  .summary-card .value { font-size: 22px; font-weight: 700; color: var(--cyan); font-family: monospace; }
  .summary-card .sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

  /* Sections */
  .section { margin-bottom: 40px; }
  .section-header { font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--cyan); border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 20px; }
  .section h2 { font-size: 18px; font-weight: 600; margin-bottom: 4px; }

  /* Info table */
  .info-table { width: 100%; border-collapse: collapse; }
  .info-table tr { border-bottom: 1px solid var(--border); }
  .info-table tr:last-child { border-bottom: none; }
  .info-table td { padding: 10px 12px; vertical-align: top; }
  .info-table td:first-child { color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; width: 200px; white-space: nowrap; }
  .info-table td:last-child { font-family: monospace; word-break: break-all; }

  /* Data card */
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 16px; }
  .card-title { font-size: 13px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }

  /* DNS records */
  .dns-tag { display: inline-block; background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 4px 10px; font-family: monospace; font-size: 13px; margin: 3px 3px 3px 0; }

  /* Record section */
  .record-type { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); margin: 16px 0 8px; }
  .record-type:first-child { margin-top: 0; }

  /* Security headers */
  .sec-header-card { display: flex; align-items: flex-start; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .sec-header-card:last-child { border-bottom: none; }
  .sec-icon { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; margin-top: 2px; }
  .sec-icon.present { background: rgba(63,185,80,0.15); color: var(--green); }
  .sec-icon.missing { background: rgba(248,81,73,0.15); color: var(--red); }
  .sec-icon.info { background: rgba(210,153,34,0.15); color: var(--amber); }
  .sec-name { font-weight: 600; font-family: monospace; font-size: 13px; }
  .sec-value { font-family: monospace; font-size: 12px; color: var(--text-muted); margin-top: 2px; word-break: break-all; }
  .sec-observation { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
  .sec-impact { font-size: 12px; color: var(--amber); margin-top: 4px; }
  .sec-rec { font-size: 12px; color: var(--cyan); margin-top: 4px; }

  /* Coverage bar */
  .coverage-bar { background: var(--surface2); border-radius: 4px; height: 8px; overflow: hidden; margin-top: 8px; }
  .coverage-fill { height: 100%; background: linear-gradient(90deg, var(--cyan), var(--green)); border-radius: 4px; }

  /* Raw data */
  .raw-block { background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 16px; font-family: monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; color: var(--text-muted); max-height: 400px; overflow-y: auto; }

  /* Error list */
  .error-item { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .error-item:last-child { border-bottom: none; }
  .error-module { background: rgba(248,81,73,0.1); color: var(--red); border: 1px solid rgba(248,81,73,0.2); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
  .error-msg { font-size: 13px; color: var(--text); }

  /* Footer */
  .footer { text-align: center; color: var(--text-muted); font-size: 12px; padding: 32px 0; border-top: 1px solid var(--border); margin-top: 40px; }
  .disclaimer { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 16px; margin-top: 24px; font-size: 12px; color: var(--text-muted); }
  .disclaimer strong { color: var(--amber); }
  
  /* Redirect chain */
  .redirect-hop { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .redirect-hop:last-child { border-bottom: none; }
  .redirect-code { font-family: monospace; font-size: 12px; min-width: 50px; }
  .redirect-url { font-family: monospace; font-size: 12px; color: var(--text-muted); word-break: break-all; }

  @media print {
    body { background: white; color: #333; }
    .cover { color: #333; }
    .summary-card, .card { border: 1px solid #ddd; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- ======= COVER ======= -->
  <div class="cover">
    <div class="logo">⬡ ReconScope</div>
    <h1>Reconnaissance Report</h1>
    <div class="target-display">{{ target }}</div>
    <div class="meta">
      <span>Scan ID: {{ scan_id[:8] }}</span>
      <span>Generated: {{ generated_at }}</span>
      <span>
        {% if status == 'completed' %}
          <span class="badge badge-green">Complete</span>
        {% elif status == 'completed_with_errors' %}
          <span class="badge badge-amber">Partial</span>
        {% else %}
          <span class="badge badge-gray">{{ status }}</span>
        {% endif %}
      </span>
    </div>
  </div>

  <!-- ======= SUMMARY CARDS ======= -->
  <div class="summary-grid">
    <div class="summary-card">
      <div class="label">Primary IP</div>
      <div class="value" style="font-size:16px">{{ ip.ipv4 if ip and ip.ipv4 else '—' }}</div>
    </div>
    <div class="summary-card">
      <div class="label">HTTP Status</div>
      <div class="value">{{ http.status_code if http and http.status_code else '—' }}</div>
      <div class="sub">{{ http.status_text if http and http.status_text else '' }}</div>
    </div>
    <div class="summary-card">
      <div class="label">SSL Status</div>
      <div class="value" style="font-size:16px">
        {% if ssl %}
          {% if ssl.status == 'VALID' %}<span style="color:var(--green)">✓ VALID</span>
          {% elif ssl.status == 'EXPIRING_SOON' %}<span style="color:var(--amber)">⚠ EXPIRING</span>
          {% elif ssl.status == 'EXPIRED' %}<span style="color:var(--red)">✗ EXPIRED</span>
          {% else %}<span style="color:var(--text-muted)">N/A</span>{% endif %}
        {% else %}—{% endif %}
      </div>
    </div>
    <div class="summary-card">
      <div class="label">DNS Records</div>
      <div class="value">{{ dns.total_records if dns else '—' }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Scan Duration</div>
      <div class="value" style="font-size:16px">{{ '%.1f'|format(duration_seconds) + 's' if duration_seconds else '—' }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Observations</div>
      <div class="value">{{ security.headers|length if security and security.headers else '0' }}</div>
    </div>
  </div>

  <!-- ======= EXECUTIVE SUMMARY ======= -->
  <div class="section">
    <div class="section-header">Executive Summary</div>
    <div class="card">
      <table class="info-table">
        <tr><td>Target</td><td>{{ target }}</td></tr>
        <tr><td>Scan ID</td><td>{{ scan_id }}</td></tr>
        <tr><td>Status</td><td>{{ status.replace('_', ' ').title() }}</td></tr>
        <tr><td>Started</td><td>{{ created_at }}</td></tr>
        <tr><td>Completed</td><td>{{ completed_at or 'N/A' }}</td></tr>
        <tr><td>Duration</td><td>{{ '%.2f seconds'|format(duration_seconds) if duration_seconds else 'N/A' }}</td></tr>
        {% if ip and ip.country %}<tr><td>Country</td><td>{{ ip.country }}</td></tr>{% endif %}
        {% if ip and ip.org %}<tr><td>Organization</td><td>{{ ip.org }}</td></tr>{% endif %}
      </table>
    </div>
  </div>

  <!-- ======= WHOIS ======= -->
  {% if whois %}
  <div class="section">
    <div class="section-header">WHOIS Information</div>
    {% if whois.available %}
    <div class="card">
      <table class="info-table">
        {% if whois.domain %}<tr><td>Domain</td><td>{{ whois.domain }}</td></tr>{% endif %}
        {% if whois.registrar %}<tr><td>Registrar</td><td>{{ whois.registrar }}</td></tr>{% endif %}
        {% if whois.creation_date %}<tr><td>Created</td><td>{{ whois.creation_date }}</td></tr>{% endif %}
        {% if whois.updated_date %}<tr><td>Updated</td><td>{{ whois.updated_date }}</td></tr>{% endif %}
        {% if whois.expiration_date %}<tr><td>Expires</td><td>{{ whois.expiration_date }}</td></tr>{% endif %}
        {% if whois.name_servers %}<tr><td>Name Servers</td><td>{{ whois.name_servers|join(', ') }}</td></tr>{% endif %}
        {% if whois.status %}<tr><td>Status</td><td>{{ whois.status|join(', ') }}</td></tr>{% endif %}
        {% if whois.emails %}<tr><td>Emails</td><td>{{ whois.emails|join(', ') }}</td></tr>{% endif %}
      </table>
    </div>
    {% else %}
    <div class="card" style="color:var(--text-muted)">WHOIS data unavailable (may be privacy-protected)</div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ======= DNS ======= -->
  {% if dns %}
  <div class="section">
    <div class="section-header">DNS Records ({{ dns.total_records }} total)</div>
    <div class="card">
      {% if dns.A %}
      <div class="record-type">A Records</div>
      {% for r in dns.A %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
      {% if dns.AAAA %}
      <div class="record-type">AAAA Records</div>
      {% for r in dns.AAAA %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
      {% if dns.MX %}
      <div class="record-type">MX Records</div>
      {% for r in dns.MX %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
      {% if dns.NS %}
      <div class="record-type">NS Records</div>
      {% for r in dns.NS %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
      {% if dns.TXT %}
      <div class="record-type">TXT Records</div>
      {% for r in dns.TXT %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
      {% if dns.CNAME %}
      <div class="record-type">CNAME Records</div>
      {% for r in dns.CNAME %}<span class="dns-tag">{{ r }}</span>{% endfor %}
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ======= IP ======= -->
  {% if ip %}
  <div class="section">
    <div class="section-header">IP &amp; Network Information</div>
    <div class="card">
      <table class="info-table">
        {% if ip.ipv4 %}<tr><td>IPv4</td><td>{{ ip.ipv4 }}</td></tr>{% endif %}
        {% if ip.ipv6 %}<tr><td>IPv6</td><td>{{ ip.ipv6 }}</td></tr>{% endif %}
        {% if ip.asn %}<tr><td>ASN</td><td>{{ ip.asn }}</td></tr>{% endif %}
        {% if ip.asn_description %}<tr><td>ASN Description</td><td>{{ ip.asn_description }}</td></tr>{% endif %}
        {% if ip.org %}<tr><td>Organization</td><td>{{ ip.org }}</td></tr>{% endif %}
        {% if ip.isp %}<tr><td>ISP</td><td>{{ ip.isp }}</td></tr>{% endif %}
        {% if ip.country %}<tr><td>Country</td><td>{{ ip.country }}{% if ip.country_code %} ({{ ip.country_code }}){% endif %}</td></tr>{% endif %}
        {% if ip.region %}<tr><td>Region</td><td>{{ ip.region }}</td></tr>{% endif %}
        {% if ip.city %}<tr><td>City</td><td>{{ ip.city }}</td></tr>{% endif %}
        {% if ip.network %}<tr><td>Network</td><td>{{ ip.network }}</td></tr>{% endif %}
      </table>
      <p style="font-size:11px;color:var(--text-muted);margin-top:12px">⚠ Geolocation data is approximate and may not be accurate.</p>
    </div>
  </div>
  {% endif %}

  <!-- ======= HTTP ======= -->
  {% if http %}
  <div class="section">
    <div class="section-header">HTTP Response</div>
    <div class="card">
      <table class="info-table">
        {% if http.status_code %}<tr><td>Status</td><td>{{ http.status_text }}</td></tr>{% endif %}
        {% if http.final_url %}<tr><td>Final URL</td><td>{{ http.final_url }}</td></tr>{% endif %}
        {% if http.response_time_ms %}<tr><td>Response Time</td><td>{{ http.response_time_ms }}ms</td></tr>{% endif %}
        {% if http.http_version %}<tr><td>HTTP Version</td><td>{{ http.http_version }}</td></tr>{% endif %}
        {% if http.server %}<tr><td>Server</td><td>{{ http.server }}</td></tr>{% endif %}
        {% if http.content_type %}<tr><td>Content-Type</td><td>{{ http.content_type }}</td></tr>{% endif %}
        {% if http.x_powered_by %}<tr><td>X-Powered-By</td><td>{{ http.x_powered_by }}</td></tr>{% endif %}
        {% if http.content_length %}<tr><td>Content-Length</td><td>{{ http.content_length }} bytes</td></tr>{% endif %}
      </table>
    </div>
    {% if http.redirect_chain %}
    <div class="card">
      <div class="card-title">Redirect Chain</div>
      {% for hop in http.redirect_chain %}
      <div class="redirect-hop">
        <span class="redirect-code badge badge-amber">{{ hop.status_code }}</span>
        <span class="redirect-url">{{ hop.url }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ======= SSL/TLS ======= -->
  {% if ssl %}
  <div class="section">
    <div class="section-header">TLS Certificate</div>
    <div class="card">
      <div style="margin-bottom:16px">
        {% if ssl.status == 'VALID' %}<span class="badge badge-green">✓ VALID</span>
        {% elif ssl.status == 'EXPIRING_SOON' %}<span class="badge badge-amber">⚠ EXPIRING SOON</span>
        {% elif ssl.status == 'EXPIRED' %}<span class="badge badge-red">✗ EXPIRED</span>
        {% else %}<span class="badge badge-gray">UNAVAILABLE</span>{% endif %}
        {% if ssl.days_remaining is not none %}<span style="margin-left:12px;color:var(--text-muted);font-size:13px">{{ ssl.days_remaining }} days remaining</span>{% endif %}
      </div>
      <table class="info-table">
        {% if ssl.common_name %}<tr><td>Common Name</td><td>{{ ssl.common_name }}</td></tr>{% endif %}
        {% if ssl.issuer_cn %}<tr><td>Issuer</td><td>{{ ssl.issuer_cn }}</td></tr>{% endif %}
        {% if ssl.not_before %}<tr><td>Valid From</td><td>{{ ssl.not_before }}</td></tr>{% endif %}
        {% if ssl.not_after %}<tr><td>Valid Until</td><td>{{ ssl.not_after }}</td></tr>{% endif %}
        {% if ssl.tls_version %}<tr><td>TLS Version</td><td>{{ ssl.tls_version }}</td></tr>{% endif %}
        {% if ssl.serial_number %}<tr><td>Serial Number</td><td>{{ ssl.serial_number }}</td></tr>{% endif %}
      </table>
      {% if ssl.san %}
      <div style="margin-top:16px">
        <div class="record-type">Subject Alternative Names</div>
        {% for name in ssl.san %}<span class="dns-tag">{{ name }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ======= WEB FILES ======= -->
  {% if web_files %}
  <div class="section">
    <div class="section-header">Web Files</div>
    <div class="card">
      <div class="card-title">robots.txt</div>
      {% if web_files.robots_txt_available %}
        <span class="badge badge-green">Available (HTTP {{ web_files.robots_txt_status }})</span>
        {% if web_files.robots_txt_content %}
        <div class="raw-block" style="margin-top:12px;max-height:200px">{{ web_files.robots_txt_content }}</div>
        {% endif %}
      {% else %}
        <span class="badge badge-gray">Not Available{% if web_files.robots_txt_status %} (HTTP {{ web_files.robots_txt_status }}){% endif %}</span>
      {% endif %}
    </div>
    <div class="card">
      <div class="card-title">sitemap.xml</div>
      {% if web_files.sitemap_xml_available %}
        <span class="badge badge-green">Available (HTTP {{ web_files.sitemap_xml_status }})</span>
        {% if web_files.sitemap_urls %}
        <div style="margin-top:12px">
          <div class="record-type">Discovered URLs ({{ web_files.sitemap_urls|length }})</div>
          {% for url in web_files.sitemap_urls[:20] %}
          <div style="font-family:monospace;font-size:12px;padding:3px 0;color:var(--cyan)">{{ url }}</div>
          {% endfor %}
          {% if web_files.sitemap_urls|length > 20 %}<div style="color:var(--text-muted);font-size:12px">...and {{ web_files.sitemap_urls|length - 20 }} more</div>{% endif %}
        </div>
        {% endif %}
      {% else %}
        <span class="badge badge-gray">Not Available{% if web_files.sitemap_xml_status %} (HTTP {{ web_files.sitemap_xml_status }}){% endif %}</span>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ======= SECURITY ======= -->
  {% if security %}
  <div class="section">
    <div class="section-header">Security Observations</div>
    <div class="card">
      <div style="display:flex;gap:20px;margin-bottom:16px;flex-wrap:wrap">
        <span><span style="color:var(--green)">●</span> {{ security.present_count }} Present</span>
        <span><span style="color:var(--red)">●</span> {{ security.missing_count }} Missing</span>
        <span><span style="color:var(--amber)">●</span> {{ security.informational_count }} Informational</span>
      </div>
      <div style="margin-bottom:8px;font-size:12px;color:var(--text-muted)">Header Coverage</div>
      <div class="coverage-bar"><div class="coverage-fill" style="width:{{ security.coverage_percent }}%"></div></div>
      <div style="text-align:right;font-size:12px;color:var(--text-muted);margin-top:4px">{{ security.coverage_percent }}%</div>
    </div>
    <div class="card">
      {% if security.headers %}
      {% for h in security.headers %}
      <div class="sec-header-card">
        <div class="sec-icon {% if h.status == 'PRESENT' %}present{% elif h.status == 'MISSING' %}missing{% else %}info{% endif %}">
          {% if h.status == 'PRESENT' %}✓{% elif h.status == 'MISSING' %}✗{% else %}ℹ{% endif %}
        </div>
        <div>
          <div class="sec-name">{{ h.name }}</div>
          {% if h.value %}<div class="sec-value">{{ h.value[:120] }}</div>{% endif %}
          {% if h.observation %}<div class="sec-observation">{{ h.observation }}</div>{% endif %}
          {% if h.impact %}<div class="sec-impact">Potential impact: {{ h.impact }}</div>{% endif %}
          {% if h.recommendation %}<div class="sec-rec">Recommendation: {{ h.recommendation }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
      {% else %}
      <p style="color:var(--text-muted)">No security header data available.</p>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ======= ERRORS ======= -->
  {% if errors %}
  <div class="section">
    <div class="section-header">Module Errors</div>
    <div class="card">
      {% for err in errors %}
      <div class="error-item">
        <span class="error-module">{{ err.module }}</span>
        <div>
          <div class="error-msg">{{ err.message }}</div>
          <div style="font-size:11px;color:var(--text-muted)">{{ err.timestamp }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ======= LIMITATIONS ======= -->
  <div class="section">
    <div class="section-header">Limitations</div>
    <div class="disclaimer">
      <p><strong>⚠ Authorized Use Only</strong> — This tool is intended exclusively for reconnaissance of systems you own or have explicit written authorization to test.</p>
      <br>
      <p>Geolocation data is approximate. WHOIS data may be incomplete due to privacy protection services. Security observations are informational and do not constitute a formal security assessment or penetration test. Results are a point-in-time snapshot and may not reflect the current state of the target.</p>
    </div>
  </div>

  <div class="footer">
    <div>ReconScope — Web Reconnaissance Automation Framework</div>
    <div>Generated {{ generated_at }} | For authorized use only</div>
  </div>

</div>
</body>
</html>
